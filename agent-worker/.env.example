# Agent Worker env
PORT=8080
WORKER_API_KEY=
WORKER_POLL_ENABLED=true
WORKER_POLL_INTERVAL_MS=10000
WORKER_MAX_ATTEMPTS=2
WORKER_CONCURRENCY=1
WORKER_STORAGE_BUCKET=bounty-artifacts
WORKER_WORKDIR=/tmp/aa-bounties-worker

SUPABASE_URL=
