SUPABASE_URL=https://mwniqoxghjquriybjdjs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TARGET_USER_ID=

SCRAPE_ENGINE_MODE=shadow_real
SCRAPE_SOURCE_KEY=manual_fixture
SCRAPE_DRY_RUN=true
ALLOW_MANUAL_FIXTURE_WRITE=false
ALLOW_FIXTURE_INPUT_WRITE=false
ALLOW_LIVE_REAL=false

SCRAPE_ADAPTER=file
SCRAPE_INPUT_FILE=./fixtures/sample-candidates.json
# For first real scrape bridge:
# SCRAPE_ADAPTER=web
# SCRAPE_SOURCE_KEY=immunefi_web
# SCRAPE_INPUT_FILE=./sources/bounty-sources.json
SCRAPE_MAX_CANDIDATES=25
SCRAPE_MAX_CONSECUTIVE_ERRORS=3
SCRAPE_CIRCUIT_COOLDOWN_MINUTES=30

# Agent brain gateway.
# Use ollama only for local development. For production remote open-weight APIs,
# use together/fireworks/groq/openrouter/openai_compatible and keep keys server-side.
AGENT_BRAIN_ENABLED=false
AGENT_BRAIN_PROVIDER=ollama
AGENT_BRAIN_BASE_URL=http://127.0.0.1:11434
AGENT_BRAIN_API_KEY=
AGENT_BRAIN_TEMPERATURE=0.15
AGENT_BRAIN_MAX_TOKENS=1200

